# LilyGO T-Deck Plus: ESP32-S3, 16 MiB QIO flash, 8 MiB OPI PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# A4-FLASH1 (ALPHA4_UI.md section 12): the project's own table, a 1.25 MiB
# factory app (was ESP-IDF's stock 1 MiB single-app table). Launcher installs
# never read it; see partitions.csv and check_app_budget.py.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The ESP32-S3FN16R8 fitted to T-Deck Plus is specified by LilyGO at 240 MHz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Route large C++ persistence/resource containers to PSRAM while preserving
# small/hot state in internal RAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
# Reach app_main and print a warning even if PSRAM cannot initialize.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Keep all static data and executable code independent of external RAM.
# CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY is not set
# CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY is not set
# CONFIG_SPIRAM_FETCH_INSTRUCTIONS is not set
# CONFIG_SPIRAM_RODATA is not set

# Serial over the board's USB-C connector, without Arduino or TinyUSB.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Native game + FAT/SD/SPI + diagnostic formatting need a real call-stack budget.
# Large app/CRC/display buffers are off-stack; require >=4 KiB measured reserve.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# A3-04B (ALPHA3_AUDIO.md section 19.4): FreeRTOS run-time statistics for the
# Developer perf report's per-core and per-task CPU (SystemPerf). The clock is
# esp_timer (microseconds); 64-bit counters never wrap within a session. The
# cost is one timer read per context switch.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
